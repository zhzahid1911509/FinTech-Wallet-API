{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FinTechWalletAPI",
    "Audience": "FinTechWalletClients",
    "AccessTokenMinutes": 10,
    "SessionDays": 7
  },
  "Email": {
    "Mode": "Pickup",
    "WorkerEnabled": true,
    "From": "wallet@example.test",
    "PickupDirectory": "App_Data/mail",
    "Port": 587,
    "Tls": "StartTls",
    "MaxAttempts": 5
  },
  "TransferRisk": {
    "SingleTransferThreshold": 5000,
    "Rolling24HoursThreshold": 15000,
    "NewRecipientThreshold": 1000,
    "AuthorizationSeconds": 120
  },
  "Reconciliation": {
    "WorkerEnabled": true,
    "IntervalSeconds": 900,
    "TimeoutSeconds": 60,
    "StaleAfterSeconds": 3600,
    "EmailBacklogMinutes": 15
  }
}
