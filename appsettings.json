{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FinTechWalletAPI",
    "Audience": "FinTechWalletClients",
    "AccessTokenMinutes": 10,
    "SessionDays": 7
  },
  "Email": {
    "Mode": "Pickup",
    "WorkerEnabled": true,
    "From": "wallet@example.test",
    "PickupDirectory": "App_Data/mail",
    "Port": 587,
    "Tls": "StartTls",
    "MaxAttempts": 5
  }
}
